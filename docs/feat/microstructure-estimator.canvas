    {"id": "e6", "fromNode": "tier2", "toNode": "model"},
    {"id": "e7", "fromNode": "tier3", "toNode": "model"},
    {"id": "e8", "fromNode": "model", "toNode": "validation"},
    {"id": "e9", "fromNode": "validation", "toNode": "gate", "label": "after"},
    {"id": "e10", "fromNode": "gate", "toNode": "deploy"},
