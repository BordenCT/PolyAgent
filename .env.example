# Mode
PAPER_TRADE=true

# Scan
SCAN_INTERVAL_HOURS=4
SCAN_MARKET_LIMIT=500

# Scoring thresholds
MIN_GAP=0.07
MIN_DEPTH=500
MIN_HOURS=4
MAX_HOURS=168

# LLM Provider: "ollama" (free), "claude" (paid), "hybrid" (ollama scanner + claude brain)
LLM_PROVIDER=ollama

# Brain (only needed if LLM_PROVIDER=claude or hybrid)
ANTHROPIC_API_KEY=
BRAIN_CONFIDENCE_THRESHOLD=0.75
BRAIN_MIN_CHECKS=3

# Kelly
KELLY_MAX_FRACTION=0.25
BANKROLL=800
# Sizing floors. MIN_FREE_BANKROLL: bankroll must stay above this
# after a trade (entry is skipped if it would cross). MIN_ORDER_SIZE:
# smallest USD notional we'll send to the CLOB; below this Kelly gets
# bumped (if headroom) or the trade is skipped. MIN_CONTRACTS: hard
# floor on whole contracts per trade — Polymarket fills integers only,
# and below this many contracts we skip rather than place the order.
MIN_FREE_BANKROLL=1.0
MIN_ORDER_SIZE=1.0
MIN_CONTRACTS=1

# Correlation cap. Caps aggregate dollar exposure across positions that
# resolve at the same settlement event (currently: same crypto asset +
# same resolution date, e.g. a BTC strike ladder for one expiry). The
# cap is this fraction of CURRENT FREE bankroll. New trades whose
# cluster sum would exceed the cap are scaled down or skipped. Anything
# the strike parser cannot place in a cluster (sports, politics, etc.)
# is treated as uncorrelated and is unaffected.
MAX_CLUSTER_EXPOSURE_FRACTION=0.10

# Crypto-venue tick-log ingestion. When TRUE the bot spawns an asyncio
# thread that subscribes to Coinbase Advanced Trade (spot orderbook +
# trades) and Bybit V5 perp (orderbook + trades + mark/index + funding)
# and persists snapshots/trades/funding into the tables created by
# migration 011. Pure data collection; no decider integration yet.
# Off by default since ingestion has non-zero DB-write cost (~200k rows
# per day combined). US-accessible: Bybit's public market-data feed
# serves from the global API endpoint regardless of geo.
MARKET_DATA_INGESTION_ENABLED=false
MARKET_DATA_COINBASE_PRODUCT=BTC-USD
MARKET_DATA_BYBIT_SYMBOL=BTCUSDT
MARKET_DATA_SNAPSHOT_INTERVAL_S=1.0
MARKET_DATA_DEPTH_LEVELS=10

# Exit
EXIT_TARGET_PCT=0.85
EXIT_VOLUME_MULTIPLIER=3
EXIT_STALE_HOURS=24
EXIT_STALE_THRESHOLD=0.02

# Workers (empty = auto-scale to cpu_count)
SCANNER_WORKERS=
BRAIN_WORKERS=
EXECUTOR_WORKERS=
EXIT_WORKERS=

# Database
DATABASE_URL=postgresql://polyagent:polyagent@polyagent-db:5432/polyagent

# Embeddings
VOYAGE_API_KEY=

# Ollama (local LLM for scanner estimates — zero cost)
OLLAMA_ENABLED=true
OLLAMA_URL=http://192.168.1.56:11434
OLLAMA_MODEL=phi4:14b

# Polymarket
POLYMARKET_API_URL=https://clob.polymarket.com

# Live order placement: requires paper_trade=false AND this flag=true AND polymarket CLI installed
POLYMARKET_LIVE_ENABLED=false

# Quant subsystem (Phi(d2) for short-horizon and strike crypto markets).
# Per-asset values (vols, edge thresholds, fees) live in
# polyagent/services/quant/assets/registry.py with QUANT_<ASSET>_* env-var
# overrides applied at startup.
QUANT_STRIKE_ENABLED=true
QUANT_SHORT_ENABLED=false
QUANT_MARKET_POLL_S=60
QUANT_POSITION_SIZE_USD=5.0
# Cascade-prevention caps. Without these, one Coinbase tick that puts
# edge above threshold can trigger correlated trades on every active
# short-horizon market in the same instant.
QUANT_MAX_TRADES_PER_CYCLE=5
QUANT_MAX_OPEN_PER_ASSET=3
# Per-asset overrides (optional; defaults are in registry.py):
# QUANT_BTC_VOL=0.60
# QUANT_BTC_EDGE_THRESHOLD=0.05
# QUANT_BTC_FEE_BPS=0.0
# QUANT_BTC_PAPER_ONLY=false
# QUANT_ETH_VOL=0.75
# QUANT_ETH_EDGE_THRESHOLD=0.05
